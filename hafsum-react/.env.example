# Copy to ".env" to enable real Google sign-in (optional — the dev login works without it).
# Use the SAME Client ID you put in hafsum-server/.env. See hafsum-server/README.md.
VITE_GOOGLE_CLIENT_ID=

# Only needed if the backend is NOT reachable via the dev proxy (e.g. a hosted API).
# VITE_API_URL=https://api.hafsum.co
