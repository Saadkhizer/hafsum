# Google sign-in is configured on the SERVER (hafsum-server/.env → GOOGLE_CLIENT_ID);
# the frontend reads it from /api/config at runtime, so you normally don't set anything
# here. This var is only an optional fallback used if /api/config can't be reached —
# if you set it, use the SAME Client ID as the server. See hafsum-server/README.md.
VITE_GOOGLE_CLIENT_ID=

# Only needed if the backend is NOT reachable via the dev proxy (e.g. a hosted API).
# VITE_API_URL=https://api.hafsum.co
