# ---- Hafsum order backend configuration ----
# Copy this file to ".env" and fill in the values.

# Port the API listens on (the frontend dev proxy expects 4000).
# Managed hosts (Render/Railway) set PORT for you — leave this as-is locally.
PORT=4000

# Where db.json is stored. Leave blank to keep it next to the server (fine for a VPS).
# On hosts with ephemeral disks, point this at a mounted volume so orders survive
# redeploys, e.g. DATA_DIR=/var/data
DATA_DIR=

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# --- Customer login via Google ---
# Create a free OAuth Client ID at https://console.cloud.google.com (see README).
# This is the single source of truth: the frontend reads it from /api/config, so
# setting it here turns Google sign-in on with no frontend rebuild.
# Leave blank to run with the built-in "dev login" only.
GOOGLE_CLIENT_ID=

# Allow the no-setup "dev login" button (handy for demos). Set to false in production.
ALLOW_DEV_LOGIN=true

# --- Shop staff (admin) login ---
# Option 1: a single email + password the shop uses to open the order console.
ADMIN_EMAIL=shop@hafsum.co
ADMIN_PASSWORD=hafsum-admin

# Option 2: Google accounts that should automatically get admin access
# (comma-separated emails). They sign in with the normal Google button.
ADMIN_GOOGLE_EMAILS=
